{
  "name": "zenbook",
  "productName": "Zenbook",
  "version": "0.1.0",
  "description": "A calm, local-first notebook where every page is an Excalidraw canvas.",
  "license": "MIT",
  "author": "Abhideep Ghosh",
  "homepage": "https://github.com/abhideepghosh/zenbook",
  "private": true,
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "fonts": "node scripts/copy-excalidraw-fonts.mjs",
    "predev": "npm run fonts",
    "dev": "electron-vite dev",
    "prebuild": "npm run fonts",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit --composite false -p tsconfig.node.json && tsc --noEmit --composite false -p tsconfig.web.json && tsc --noEmit --composite false -p tsconfig.e2e.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "e2e": "npm run build && playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run e2e",
    "fixture": "node scripts/make-fixture.mjs",
    "dist": "npm run build && electron-builder"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@eslint/js": "10.0.1",
    "@excalidraw/excalidraw": "0.18.1",
    "@lezer/highlight": "1.2.5",
    "@lezer/markdown": "1.8.1",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "minisearch": "7.2.0",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}
